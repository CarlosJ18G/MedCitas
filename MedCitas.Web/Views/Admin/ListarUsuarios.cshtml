
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var pacientes = ViewBag.Pacientes as List<MedCitas.Core.Entities.Paciente> ?? new List<MedCitas.Core.Entities.Paciente>();
    var doctores = ViewBag.Doctores as List<MedCitas.Core.Entities.Doctor> ?? new List<MedCitas.Core.Entities.Doctor>();
    var admins = ViewBag.Admins as List<MedCitas.Core.Entities.Admin> ?? new List<MedCitas.Core.Entities.Admin>();
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="bi bi-people-fill"></i> Gestión de Usuarios
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <a asp-action="Dashboard" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <strong>¡Éxito!</strong> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Error:</strong> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Estadísticas Resumidas -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-primary text-white me-3">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <h4 class="mb-0">@pacientes.Count</h4>
                            <small class="text-muted">Pacientes</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-success text-white me-3">
                            <i class="bi bi-hospital-fill"></i>
                        </div>
                        <div>
                            <h4 class="mb-0">@doctores.Count</h4>
                            <small class="text-muted">Médicos</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-warning text-white me-3">
                            <i class="bi bi-shield-fill-check"></i>
                        </div>
                        <div>
                            <h4 class="mb-0">@admins.Count</h4>
                            <small class="text-muted">Administradores</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs de Usuarios -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <ul class="nav nav-tabs card-header-tabs" id="userTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pacientes-tab" data-bs-toggle="tab" data-bs-target="#pacientes" type="button" role="tab" aria-controls="pacientes" aria-selected="true">
                        <i class="bi bi-people"></i> Pacientes (@pacientes.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="doctores-tab" data-bs-toggle="tab" data-bs-target="#doctores" type="button" role="tab" aria-controls="doctores" aria-selected="false">
                        <i class="bi bi-hospital"></i> Médicos (@doctores.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="admins-tab" data-bs-toggle="tab" data-bs-target="#admins" type="button" role="tab" aria-controls="admins" aria-selected="false">
                        <i class="bi bi-shield-check"></i> Administradores (@admins.Count)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content" id="userTabsContent">
                <!-- TAB PACIENTES -->
                <div class="tab-pane fade show active" id="pacientes" role="tabpanel" aria-labelledby="pacientes-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul"></i> Lista de Pacientes
                        </h5>
                        <a asp-action="RegistrarPaciente" class="btn btn-primary btn-sm">
                            <i class="bi bi-person-plus-fill"></i> Nuevo Paciente
                        </a>
                    </div>

                    <div class="mb-3">
                        <input type="text" id="searchPacientes" class="form-control" placeholder="Buscar paciente por nombre, documento o correo...">
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="tablaPacientes">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Documento</th>
                                    <th>Correo</th>
                                    <th>Teléfono</th>
                                    <th>EPS</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (pacientes.Any())
                                {
                                    @foreach (var paciente in pacientes)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="user-avatar bg-primary text-white me-2">
                                                        @paciente.NombreCompleto.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">@paciente.NombreCompleto</div>
                                                        <small class="text-muted">@paciente.TipoSangre</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@paciente.TipoDocumento</span>
                                                @paciente.NumeroDocumento
                                            </td>
                                            <td>
                                                <i class="bi bi-envelope"></i>
                                                @paciente.CorreoElectronico
                                            </td>
                                            <td>
                                                <i class="bi bi-telephone"></i>
                                                @paciente.Telefono
                                            </td>
                                            <td>@paciente.Eps</td>
                                            <td>
                                                @if (paciente.EstaVerificado)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle"></i> Verificado
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-clock"></i> Pendiente
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-info" onclick="verDetallePaciente('@paciente.Id')">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">
                                            <i class="bi bi-inbox fs-1"></i>
                                            <p class="mb-0">No hay pacientes registrados</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB DOCTORES -->
                <div class="tab-pane fade" id="doctores" role="tabpanel" aria-labelledby="doctores-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul"></i> Lista de Médicos
                        </h5>
                        <a asp-action="RegistrarDoctor" class="btn btn-success btn-sm">
                            <i class="bi bi-hospital"></i> Nuevo Médico
                        </a>
                    </div>

                    <div class="mb-3">
                        <input type="text" id="searchDoctores" class="form-control" placeholder="Buscar médico por nombre, licencia o especialidad...">
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="tablaDoctores">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Especialidad</th>
                                    <th>Licencia</th>
                                    <th>Correo</th>
                                    <th>Teléfono</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (doctores.Any())
                                {
                                    @foreach (var doctor in doctores)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="user-avatar bg-success text-white me-2">
                                                        @doctor.NombreCompleto.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <div class="fw-bold">@doctor.NombreCompleto</div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    <i class="bi bi-heart-pulse"></i>
                                                    @doctor.Specialty?.Nombre
                                                </span>
                                            </td>
                                            <td>
                                                <code>@doctor.NumeroLicencia</code>
                                            </td>
                                            <td>
                                                <i class="bi bi-envelope"></i>
                                                @(doctor.CorreoElectronico ?? "N/A")
                                            </td>
                                            <td>
                                                <i class="bi bi-telephone"></i>
                                                @(doctor.Telefono ?? "N/A")
                                            </td>
                                            <td>
                                                @if (doctor.EstaActivo)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle"></i> Activo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-x-circle"></i> Inactivo
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-info" onclick="verDetalleDoctor('@doctor.Id')">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">
                                            <i class="bi bi-inbox fs-1"></i>
                                            <p class="mb-0">No hay médicos registrados</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TAB ADMINISTRADORES -->
                <div class="tab-pane fade" id="admins" role="tabpanel" aria-labelledby="admins-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul"></i> Lista de Administradores
                        </h5>
                        <a asp-action="RegistrarAdmin" class="btn btn-warning btn-sm">
                            <i class="bi bi-shield-fill-plus"></i> Nuevo Administrador
                        </a>
                    </div>

                    <div class="mb-3">
                        <input type="text" id="searchAdmins" class="form-control" placeholder="Buscar administrador por nombre o correo...">
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="tablaAdmins">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Correo</th>
                                    <th>Teléfono</th>
                                    <th>Fecha Registro</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (admins.Any())
                                {
                                    @foreach (var admin in admins)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="user-avatar bg-warning text-dark me-2">
                                                        @admin.NombreCompleto.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <div class="fw-bold">@admin.NombreCompleto</div>
                                                </div>
                                            </td>
                                            <td>
                                                <i class="bi bi-envelope"></i>
                                                @admin.CorreoElectronico
                                            </td>
                                            <td>
                                                <i class="bi bi-telephone"></i>
                                                @admin.Telefono
                                            </td>
                                            <td>
                                                <i class="bi bi-calendar"></i>
                                                @admin.FechaRegistro.ToString("dd/MM/yyyy")
                                            </td>
                                            <td>
                                                @if (admin.EstaVerificado)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle"></i> Verificado
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-clock"></i> Pendiente
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-info" onclick="verDetalleAdmin('@admin.Id')">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">
                                            <i class="bi bi-inbox fs-1"></i>
                                            <p class="mb-0">No hay administradores registrados</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalles (Reutilizable) -->
<div class="modal fade" id="detalleModal" tabindex="-1" aria-labelledby="detalleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleModalLabel">
                    <i class="bi bi-info-circle"></i> Detalles del Usuario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detalleContenido">
                <!-- Contenido dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .table thead th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .nav-tabs .nav-link {
            color: #6c757d;
        }

            .nav-tabs .nav-link.active {
                font-weight: 600;
            }

        .breadcrumb {
            background-color: transparent;
            padding: 0;
            margin: 0;
        }

        .card {
            transition: transform 0.2s;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }
    </style>
}

@section Scripts {
    <script>
        // Búsqueda en tabla de Pacientes
        document.getElementById('searchPacientes').addEventListener('keyup', function() {
            filterTable('tablaPacientes', this.value);
        });

        // Búsqueda en tabla de Doctores
        document.getElementById('searchDoctores').addEventListener('keyup', function() {
            filterTable('tablaDoctores', this.value);
        });

        // Búsqueda en tabla de Admins
        document.getElementById('searchAdmins').addEventListener('keyup', function() {
            filterTable('tablaAdmins', this.value);
        });

        function filterTable(tableId, searchValue) {
            const table = document.getElementById(tableId);
            const tr = table.getElementsByTagName('tr');
            const filter = searchValue.toUpperCase();

            for (let i = 1; i < tr.length; i++) {
                const td = tr[i].getElementsByTagName('td');
                let found = false;

                for (let j = 0; j < td.length; j++) {
                    if (td[j]) {
                        const textValue = td[j].textContent || td[j].innerText;
                        if (textValue.toUpperCase().indexOf(filter) > -1) {
                            found = true;
                            break;
                        }
                    }
                }

                tr[i].style.display = found ? '' : 'none';
            }
        }

        function verDetallePaciente(id) {
            showModal('Paciente', id);
        }

        function verDetalleDoctor(id) {
            showModal('Doctor', id);
        }

        function verDetalleAdmin(id) {
            showModal('Administrador', id);
        }

        function showModal(tipo, id) {
            const modal = new bootstrap.Modal(document.getElementById('detalleModal'));
            const contenido = document.getElementById('detalleContenido');

            contenido.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-3">Cargando información del ${tipo.toLowerCase()}...</p>
                </div>
            `;

            modal.show();

            // TODO: Implementar llamada AJAX para obtener detalles
            setTimeout(() => {
                contenido.innerHTML = `
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>ID del ${tipo}:</strong> ${id}
                        <br>
                        <small>Funcionalidad de detalles completa pendiente de implementación.</small>
                    </div>
                `;
            }, 500);
        }
    </script>
}